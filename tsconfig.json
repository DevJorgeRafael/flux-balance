{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "paths": {
      "react-native": [
        "./node_modules/react-native/types_generated/index.d.ts"
      ],
      "react-native/*": [
        "./node_modules/react-native/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "example",
    "node_modules"
  ]
}
