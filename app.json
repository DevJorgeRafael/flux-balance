{
  "expo": {
    "name": "Flux Balance",
    "slug": "flux-balance",
    "version": "1.6.5",
    "orientation": "portrait",
    "icon": "./assets/images/logos-app/icon-1024.png",
    "scheme": "fluxbalance",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0E1A",
    "ios": {
      "bundleIdentifier": "com.devjorgerafael.flux-balance",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.devjorgerafael.flux_balance",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#1642AF",
        "foregroundImage": "./assets/images/logos-app/logo-foreground-1024.png",
        "monochromeImage": "./assets/images/logos-app/logo-monochrome-1024.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logos-app/icon-1024.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1642AF",
          "image": "./assets/images/logos-app/logo-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/images/logos-app/logo-splash.png",
            "backgroundColor": "#0A0E1A"
          }
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "expo-system-ui",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "4026deb6-47ca-4bd5-90a2-864716268936"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
