{
  "expo": {
    "name": "flux-balance",
    "slug": "flux-balance",
    "version": "1.6.3",
    "orientation": "portrait",
    "icon": "./assets/images/logos-app/flux-balance-logo-512.png",
    "scheme": "fluxbalance",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0E1A",
    "ios": {
      "buildNumber": "1"
    },
    "android": {
      "versionCode": 1,
      "allowBackup": false,
      "icon": "./assets/images/logos-app/flux-balance-logo-512.png",
      "adaptiveIcon": {
        "backgroundColor": "#1642AF",
        "foregroundImage": "./assets/images/logos-app/flux-balance-logo-512.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logos-app/flux-balance-logo-512.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1642AF",
          "image": "./assets/images/logos-app/flux-balance-logo-512.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "expo-system-ui",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
